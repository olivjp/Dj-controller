<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.4+">
    <info>
        <name>Pioneer DDJ-FLX4 Open-Source ATmega32U4 Clone</name>
        <author>Joao Paulo Ferreira (Club AI / UFSCar)</author>
        <description>2-Deck USB-MIDI Controller inspired by Pioneer DDJ-FLX4 (ATmega32U4 + 2x CD74HC4067M + 4x4 Diode Matrix + 2x EC11 Jog Encoders)</description>
    </info>
    <controller id="DDJ_FLX4_ATmega32U4">
        <controls>
            <!-- DECK A ANALOG (Channel 1: 0xB0) -->
            <control><group>[Channel1]</group><key>pregain</key><status>0xB0</status><midino>0x04</midino></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter3</key><status>0xB0</status><midino>0x07</midino></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter2</key><status>0xB0</status><midino>0x0B</midino></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter1</key><status>0xB0</status><midino>0x0F</midino></control>
            <control><group>[QuickEffectRack1_[Channel1]]</group><key>super1</key><status>0xB0</status><midino>0x13</midino></control>
            <control><group>[Channel1]</group><key>rate</key><status>0xB0</status><midino>0x00</midino></control>
            <control><group>[Channel1]</group><key>jog</key><status>0xB0</status><midino>0x22</midino></control>

            <!-- DECK B ANALOG (Channel 2: 0xB1) -->
            <control><group>[Channel2]</group><key>pregain</key><status>0xB1</status><midino>0x04</midino></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter3</key><status>0xB1</status><midino>0x07</midino></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter2</key><status>0xB1</status><midino>0x0B</midino></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter1</key><status>0xB1</status><midino>0x0F</midino></control>
            <control><group>[QuickEffectRack1_[Channel2]]</group><key>super1</key><status>0xB1</status><midino>0x13</midino></control>
            <control><group>[Channel2]</group><key>rate</key><status>0xB1</status><midino>0x00</midino></control>
            <control><group>[Channel2]</group><key>jog</key><status>0xB1</status><midino>0x22</midino></control>

            <!-- MIXER FADERS & MASTER (Channel 3: 0xB2) -->
            <control><group>[Channel1]</group><key>volume</key><status>0xB2</status><midino>0x13</midino></control>
            <control><group>[Channel2]</group><key>volume</key><status>0xB2</status><midino>0x14</midino></control>
            <control><group>[Master]</group><key>crossfader</key><status>0xB2</status><midino>0x1F</midino></control>
            <control><group>[Master]</group><key>gain</key><status>0xB2</status><midino>0x18</midino></control>

            <!-- DECK A PERFORMANCE PADS 1..8 (0x90 / 0x24..0x2B) -->
            <control><group>[Channel1]</group><key>hotcue_1_activate</key><status>0x90</status><midino>0x24</midino></control>
            <control><group>[Channel1]</group><key>hotcue_2_activate</key><status>0x90</status><midino>0x25</midino></control>
            <control><group>[Channel1]</group><key>hotcue_3_activate</key><status>0x90</status><midino>0x26</midino></control>
            <control><group>[Channel1]</group><key>hotcue_4_activate</key><status>0x90</status><midino>0x27</midino></control>
            <control><group>[Channel1]</group><key>hotcue_5_activate</key><status>0x90</status><midino>0x28</midino></control>
            <control><group>[Channel1]</group><key>hotcue_6_activate</key><status>0x90</status><midino>0x29</midino></control>
            <control><group>[Channel1]</group><key>hotcue_7_activate</key><status>0x90</status><midino>0x2A</midino></control>
            <control><group>[Channel1]</group><key>hotcue_8_activate</key><status>0x90</status><midino>0x2B</midino></control>

            <!-- DECK B PERFORMANCE PADS 1..8 (0x91 / 0x30..0x37) -->
            <control><group>[Channel2]</group><key>hotcue_1_activate</key><status>0x91</status><midino>0x30</midino></control>
            <control><group>[Channel2]</group><key>hotcue_2_activate</key><status>0x91</status><midino>0x31</midino></control>
            <control><group>[Channel2]</group><key>hotcue_3_activate</key><status>0x91</status><midino>0x32</midino></control>
            <control><group>[Channel2]</group><key>hotcue_4_activate</key><status>0x91</status><midino>0x33</midino></control>
            <control><group>[Channel2]</group><key>hotcue_5_activate</key><status>0x91</status><midino>0x34</midino></control>
            <control><group>[Channel2]</group><key>hotcue_6_activate</key><status>0x91</status><midino>0x35</midino></control>
            <control><group>[Channel2]</group><key>hotcue_7_activate</key><status>0x91</status><midino>0x36</midino></control>
            <control><group>[Channel2]</group><key>hotcue_8_activate</key><status>0x91</status><midino>0x37</midino></control>

            <!-- TRANSPORT & MIXER MATRIX (0x92 / 0x40..0x4F) -->
            <control><group>[Channel1]</group><key>LoadSelectedTrack</key><status>0x92</status><midino>0x40</midino></control>
            <control><group>[Channel2]</group><key>LoadSelectedTrack</key><status>0x92</status><midino>0x41</midino></control>
            <control><group>[Channel1]</group><key>pfl</key><status>0x92</status><midino>0x44</midino></control>
            <control><group>[Channel2]</group><key>pfl</key><status>0x92</status><midino>0x45</midino></control>
            <control><group>[Channel1]</group><key>beatloop_activate</key><status>0x92</status><midino>0x46</midino></control>
            <control><group>[Channel1]</group><key>sync_enabled</key><status>0x92</status><midino>0x47</midino></control>
            <control><group>[Channel1]</group><key>cue_default</key><status>0x92</status><midino>0x48</midino></control>
            <control><group>[Channel1]</group><key>play</key><status>0x92</status><midino>0x49</midino></control>
            <control><group>[Channel2]</group><key>beatloop_activate</key><status>0x92</status><midino>0x4A</midino></control>
            <control><group>[Channel2]</group><key>sync_enabled</key><status>0x92</status><midino>0x4B</midino></control>
            <control><group>[Channel2]</group><key>cue_default</key><status>0x92</status><midino>0x4C</midino></control>
            <control><group>[Channel2]</group><key>play</key><status>0x92</status><midino>0x4D</midino></control>
        </controls>
    </controller>
</MixxxControllerPreset>
