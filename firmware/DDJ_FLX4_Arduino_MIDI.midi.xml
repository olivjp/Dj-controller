<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.4+">
    <info>
        <name>DDJ-FLX4 Modular Core v2.0 (ATmega32U4 14-bit Pitch + JS Jog)</name>
        <author>Joao Paulo Ferreira (Club AI / UFSCar)</author>
        <description>2-Deck USB-MIDI DJ Controller v2.0 (Pro Micro ATmega32U4, 14-bit Tempo Pitch Bend, JS Relative Jog Wheels, 16 Pads, 4x4 Matrix)</description>
    </info>
    <controller id="DDJ_FLX4_ATmega32U4_v2">
        <scriptfiles>
            <file filename="DDJ_FLX4_Arduino_MIDI.scripts.js" functionprefix="DDJFLX4"/>
        </scriptfiles>
        <controls>
            <!-- DECK A ANALOG (Channel 1: 0xB0 / 14-bit Pitch Bend: 0xE0) -->
            <control><group>[Channel1]</group><key>pregain</key><status>0xB0</status><midino>0x04</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter3</key><status>0xB0</status><midino>0x07</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter2</key><status>0xB0</status><midino>0x0B</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter1</key><status>0xB0</status><midino>0x0F</midino><options><normal/></options></control>
            <control><group>[QuickEffectRack1_[Channel1]]</group><key>super1</key><status>0xB0</status><midino>0x13</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>DDJFLX4.pitchFader</key><status>0xE0</status><options><script-binding/></options></control>
            <control><group>[Channel1]</group><key>DDJFLX4.jogWheel</key><status>0xB0</status><midino>0x22</midino><options><script-binding/></options></control>

            <!-- DECK B ANALOG (Channel 2: 0xB1 / 14-bit Pitch Bend: 0xE1) -->
            <control><group>[Channel2]</group><key>pregain</key><status>0xB1</status><midino>0x04</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter3</key><status>0xB1</status><midino>0x07</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter2</key><status>0xB1</status><midino>0x0B</midino><options><normal/></options></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter1</key><status>0xB1</status><midino>0x0F</midino><options><normal/></options></control>
            <control><group>[QuickEffectRack1_[Channel2]]</group><key>super1</key><status>0xB1</status><midino>0x13</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>DDJFLX4.pitchFader</key><status>0xE1</status><options><script-binding/></options></control>
            <control><group>[Channel2]</group><key>DDJFLX4.jogWheel</key><status>0xB1</status><midino>0x22</midino><options><script-binding/></options></control>

            <!-- MIXER FADERS & MASTER (Channel 3: 0xB2) -->
            <control><group>[Channel1]</group><key>volume</key><status>0xB2</status><midino>0x13</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>volume</key><status>0xB2</status><midino>0x14</midino><options><normal/></options></control>
            <control><group>[Master]</group><key>crossfader</key><status>0xB2</status><midino>0x1F</midino><options><normal/></options></control>
            <control><group>[Master]</group><key>gain</key><status>0xB2</status><midino>0x18</midino><options><normal/></options></control>

            <!-- DECK A PERFORMANCE PADS 1..8 (Note On 0x90 & Note Off 0x80) -->
            <control><group>[Channel1]</group><key>hotcue_1_activate</key><status>0x90</status><midino>0x24</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_1_activate</key><status>0x80</status><midino>0x24</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_2_activate</key><status>0x90</status><midino>0x25</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_2_activate</key><status>0x80</status><midino>0x25</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_3_activate</key><status>0x90</status><midino>0x26</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_3_activate</key><status>0x80</status><midino>0x26</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_4_activate</key><status>0x90</status><midino>0x27</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_4_activate</key><status>0x80</status><midino>0x27</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_5_activate</key><status>0x90</status><midino>0x28</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_5_activate</key><status>0x80</status><midino>0x28</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_6_activate</key><status>0x90</status><midino>0x29</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_6_activate</key><status>0x80</status><midino>0x29</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_7_activate</key><status>0x90</status><midino>0x2A</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_7_activate</key><status>0x80</status><midino>0x2A</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_8_activate</key><status>0x90</status><midino>0x2B</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>hotcue_8_activate</key><status>0x80</status><midino>0x2B</midino><options><normal/></options></control>

            <!-- DECK B PERFORMANCE PADS 1..8 (Note On 0x91 & Note Off 0x81) -->
            <control><group>[Channel2]</group><key>hotcue_1_activate</key><status>0x91</status><midino>0x30</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_1_activate</key><status>0x81</status><midino>0x30</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_2_activate</key><status>0x91</status><midino>0x31</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_2_activate</key><status>0x81</status><midino>0x31</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_3_activate</key><status>0x91</status><midino>0x32</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_3_activate</key><status>0x81</status><midino>0x32</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_4_activate</key><status>0x91</status><midino>0x33</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_4_activate</key><status>0x81</status><midino>0x33</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_5_activate</key><status>0x91</status><midino>0x34</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_5_activate</key><status>0x81</status><midino>0x34</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_6_activate</key><status>0x91</status><midino>0x35</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_6_activate</key><status>0x81</status><midino>0x35</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_7_activate</key><status>0x91</status><midino>0x36</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_7_activate</key><status>0x81</status><midino>0x36</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_8_activate</key><status>0x91</status><midino>0x37</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>hotcue_8_activate</key><status>0x81</status><midino>0x37</midino><options><normal/></options></control>

            <!-- COMPLETE 4x4 TRANSPORT & MIXER MATRIX (ALL 16 BUTTONS MAPPED: 0x40..0x4F) -->
            <control><group>[Channel1]</group><key>LoadSelectedTrack</key><status>0x92</status><midino>0x40</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>LoadSelectedTrack</key><status>0x92</status><midino>0x41</midino><options><normal/></options></control>
            <control><group>[QuickEffectRack1_[Channel1]]</group><key>enabled</key><status>0x92</status><midino>0x42</midino><options><normal/></options></control>
            <control><group>[EffectRack1_EffectUnit1]</group><key>group_[Channel1]_enable</key><status>0x92</status><midino>0x43</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>pfl</key><status>0x92</status><midino>0x44</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>pfl</key><status>0x92</status><midino>0x45</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_activate</key><status>0x92</status><midino>0x46</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>sync_enabled</key><status>0x92</status><midino>0x47</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>cue_default</key><status>0x92</status><midino>0x48</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>cue_default</key><status>0x82</status><midino>0x48</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>play</key><status>0x92</status><midino>0x49</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_activate</key><status>0x92</status><midino>0x4A</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>sync_enabled</key><status>0x92</status><midino>0x4B</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>cue_default</key><status>0x92</status><midino>0x4C</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>cue_default</key><status>0x82</status><midino>0x4C</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>play</key><status>0x92</status><midino>0x4D</midino><options><normal/></options></control>

            <!-- JOG WHEEL PUSH SWITCHES (ENC1_SW = 0x4E, ENC2_SW = 0x4F: Hold to Scratch / Toggle Mode) -->
            <control><group>[Channel1]</group><key>DDJFLX4.jogPush</key><status>0x92</status><midino>0x4E</midino><options><script-binding/></options></control>
            <control><group>[Channel1]</group><key>DDJFLX4.jogPush</key><status>0x82</status><midino>0x4E</midino><options><script-binding/></options></control>
            <control><group>[Channel2]</group><key>DDJFLX4.jogPush</key><status>0x92</status><midino>0x4F</midino><options><script-binding/></options></control>
            <control><group>[Channel2]</group><key>DDJFLX4.jogPush</key><status>0x82</status><midino>0x4F</midino><options><script-binding/></options></control>
        </controls>
    </controller>
</MixxxControllerPreset>
